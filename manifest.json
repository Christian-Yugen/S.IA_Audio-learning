{
  "manifest_version": 3,
  "name": "S·IA | Audio-learning da UXBRAS®",
  "version": "1.4.0",
  "description": "Lê as legendas de aulas do Coursera em voz alta.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "S·IA",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.coursera.org/*"],
      "js": ["content.js"]
    }
  ]
}
