{
  "manifest_version": 3,
  "name": "S·IA | Audio-learning by UXBRAS®",
  "version": "1.7.0",
  "description": "Lê, sincroniza e permite revisar as legendas de aulas do Coursera.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "S·IA",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "replay-last-sentence": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Repetir a última frase com a S·IA"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.coursera.org/*"],
      "js": ["sync-engine.js", "content.js"]
    }
  ]
}
